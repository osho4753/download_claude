API_KEY=change-me-to-a-long-random-string
# Public address of the server; used to build file_url. Leave empty to derive from the request.
PUBLIC_BASE_URL=https://media.example.com
# Delete downloaded files older than N hours (0 = keep forever)
FILE_TTL_HOURS=24
# Max size of a single download in MB (0 = unlimited)
MAX_FILESIZE_MB=1024

# Optional: upload results to Supabase Storage instead of serving them locally.
# Project Settings -> API: Project URL and the service_role / secret key.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=media
SUPABASE_MAX_MB=50

# Optional: download YouTube via Apify (YouTube blocks most cloud server IPs).
APIFY_TOKEN=
# always = YouTube only via Apify; fallback = try yt-dlp first
YOUTUBE_VIA_APIFY=fallback
APIFY_VIDEO_QUALITY=720p
APIFY_AUDIO_QUALITY=360p
